{#
  Google Tag Manager container, head half.

  Include this immediately AFTER <meta charset>, not before. GTM asks to sit as
  high in the head as possible, but the charset declaration has to land inside
  the first 1024 bytes or the parser guesses the encoding — and this site's copy
  is full of curly quotes and em dashes that render as mojibake on a wrong guess.
  One line lower costs nothing.

  Renders nothing while site.gtmId is empty, so the scaffold ships inert.
#}
{%- if site.gtmId %}
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','{{ site.gtmId }}');</script>
<!-- End Google Tag Manager -->
{%- endif %}
